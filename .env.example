# Never put real secrets in version control. Official Kaggle credentials:
KAGGLE_USERNAME=
KAGGLE_KEY=
# Alternatively, new Kaggle API tokens are supported by the official client.
KAGGLE_API_TOKEN=
KS_ARTIFACT_ROOT=artifacts
KS_LLM_PROVIDER=openrouter
# openai-compatible, openrouter, groq, or local (e.g. Ollama's /v1 endpoint)
KS_LLM_BASE_URL=
# Replace these placeholders before starting a live agentic run.
KS_LLM_API_KEY=your-openrouter-api-key
KS_LLM_MODEL=your-selected-model-id
KS_LLM_TIMEOUT=600
# Requested output budget, including reasoning where counted by the provider (128–32768).
KS_LLM_MAX_TOKENS=32768
# Agentic mode can use native function calls; false uses validated JSON actions.
KS_LLM_NATIVE_TOOLS=false
# Only summary schema/quality statistics are sent to the LLM, never CSV rows.
